# Copy to .env.local (or .env) and fill in real values.
# See GETTING_STARTED.md for setup instructions.

# --- Database (required) ---
# Any one of these works; DATABASE_URL wins. Vercel Postgres sets POSTGRES_*.
DATABASE_URL="postgresql://user:password@localhost:5432/smalltown"
# POSTGRES_URL=""
# POSTGRES_PRISMA_URL=""
# POSTGRES_URL_NON_POOLING=""

# --- Auth (required) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# NEXTAUTH_SECRET is accepted as a fallback name for AUTH_SECRET.

# --- Mapbox (required for the homepage map) ---
NEXT_PUBLIC_MAPBOX_TOKEN=""

# --- Cloudflare R2 photo storage (required for uploads) ---
R2_ACCOUNT_ID=""
R2_BUCKET=""
# R2_ENDPOINT=""            # optional; derived from R2_ACCOUNT_ID if unset
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BASE_URL="https://photos.smalltown.gallery"

# --- Legacy photo serving (/photos/* rewrite) ---
LEGACY_PHOTOS_BASE_URL="https://photos.smalltown.gallery/legacy"

# --- Seeding (required when running prisma db seed) ---
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Import scripts only (optional) ---
# FLICKR_API_KEY=""
# FLICKR_USER_ID=""
# LOCAL_TOWNS_ROOT=""            # filesystem path to legacy towns/ directory
# LEGACY_PLACEHOLDER_EMAIL=""
# LEGACY_PLACEHOLDER_NAME=""
# LEGACY_PUBLISH_ON_IMPORT=""
